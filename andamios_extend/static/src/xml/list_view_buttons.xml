<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="andamios_extend.ListView.buttons" t-inherit="web.ListView.Buttons" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_list_buttons')]" position="after">
            <button 
            type="button"
            t-if="this.props.resModel === 'account.analytic.line'"
            t-on-click="_onCreateTimesheets"
            class="btn btn-primary o_create_timesheets_button">
                    Create timesheets
            </button>
        </xpath>
    </t>
</templates>
