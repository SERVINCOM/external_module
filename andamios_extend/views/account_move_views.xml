<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="account_move_form" model="ir.ui.view">
        <field name="name">account.move.form.view.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="order_ref"/>
                <field name="contact_name"/>
                <field name="scaffold_id"/>
            </xpath>
            <xpath expr="//field[@name='project_id']" position="attributes">
                <attribute name="readonly">False</attribute>
            </xpath>
            <xpath expr="//field[@name='cubic_meters_tasks']" position="attributes">
                <attribute name="domain">[('project_id','=',context.get('project_ref_id', project_id)), ('scaffold_id', '=', context.get('scaffold_ref_id', scaffold_id)), ('id', 'not in', cubic_meters_tasks), ('facture_in_partial', '=', False), ('is_parent', '=', False)]</attribute>
            </xpath>
        </field>
    </record>
  </data>
</odoo>
