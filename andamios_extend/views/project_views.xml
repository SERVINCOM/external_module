<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_project_task_form_material" model="ir.ui.view">
        <field name="name">project.task.form.material</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project_task_material.view_project_task_form_material"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='material_ids']//list" position="inside">
                <field name="currency_id" invisible="1"/>
                <field name="price" widget="monetary"/>
                <field name="price_subtotal" widget="monetary"/>
            </xpath>
            <xpath expr="//field[@name='material_ids']//list//field[@name='quantity']" position="before">
                <field name="task_id" column_invisible="1"/>
                <field name="subtask_id" domain="[('parent_id','=', task_id),('task_type', '!=', 'partial')]"/>
            </xpath>
            <xpath expr="//field[@name='material_ids']" position="after">
                <group class="oe_subtotal_footer oe_right" colspan="2" name="sale_total">
                    <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                        <label for="material_total"/>
                    </div>
                    <field name="currency_id" invisible="1"/>
                    <field name="material_total" nolabel="1" class="oe_subtotal_footer_separator" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='material_used']" position="attributes">
                <attribute name="invisible">is_parent == False</attribute>
            </xpath>
        </field>
    </record>

    <record id="project_task_form_inherited_view" model="ir.ui.view">
        <field name="name">project.task.form.inherited.view</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button invisible="parent_id != False"
                  name="action_generate_partial_task"
                  string="Create Partial Part"
                  type="object"
                  class="btn-primary"/>
                <button invisible="task_type != 'partial' or stage_id == %(project_task_default_stage.project_tt_cancel)d"
                  name="action_cancelled_partial_task"
                  string="Cancel"
                  type="object"
                  class="btn-secondary"/>
            </xpath>

            <xpath expr="//page[@id='timesheets_tab']" position="attributes">
                <attribute name="invisible">allow_timesheets == False or scaffold_id != False</attribute>
            </xpath>

            <xpath expr="//page[@id='timesheets_tab']" position="after">
                <page string="Timesheets" id="custom_timesheets_tab" invisible="scaffold_id == False or parent_id != False" >
                    <field name="custom_timesheet_ids" mode="list,kanban">
                        <list editable="bottom" default_order="date">
                            <field name="date"/>
                            <field name="type_hour" required="1"/>
                            <field name="employee_id" required="1" widget="many2one_avatar_employee" context="{'active_test': True}"/>
                            <field name="name" required="0"/>
                            <field name="task_id"/>
                            <field name="subtask_id" domain="[('parent_id', '=', task_id)]"/>
                            <field name="unit_amount" widget="timesheet_uom" decoration-danger="unit_amount &gt; 24"/>
                        </list>
                        <kanban class="o_kanban_mobile">
                            <field name="date"/>
                            <field name="type_hour"/>
                            <field name="employee_id" widget="many2one_avatar_employee" context="{'active_test': True}"/>
                            <field name="name"/>
                            <field name="task_id" invisible="1"/>
                            <field name="subtask_id" invisible="1"/>
                            <field name="unit_amount" decoration-danger="unit_amount &gt; 24"/>

                            <templates>
                                <t t-name="card">
                                    <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                        <div class="row">
                                            <div class="col-6">
                                                <strong><span><t t-esc="record.employee_id.value"/></span></strong>
                                            </div>
                                            <div class="col-6 pull-right text-right">
                                                <strong><t t-esc="record.date.value"/></strong>
                                            </div>
                                        </div>
                                        <div class="row">
                                          <div class="col-6">
                                                <strong><span><t t-esc="record.task_id.name.value"/></span></strong>
                                          </div>
                                          <div class="col-6">
                                                <strong><span><t t-esc="record.subtask_id.name.value"/></span></strong>
                                          </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-12">
                                                <strong><span><t t-esc="record.type_hour.value"/></span></strong>
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-6 text-muted">
                                                <span><t t-esc="record.name.value"/></span>
                                            </div>
                                            <div class="col-6">
                                                <span class="pull-right text-right">
                                                    <field name="unit_amount" widget="float_time"/>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </t>
                            </templates>
                        </kanban>
                        <form string="Timesheet Activities">
                            <sheet>
                                <group>
                                    <field name="date"/>
                                    <field name="type_hour" required="1"/>
                                    <field name="employee_id" required="1" widget="many2one_avatar_employee" context="{'active_test': True}"/>
                                    <field name="name" required="0"/>
                                    <field name="task_id"/>
                                    <field name="subtask_id" domain="[('parent_id', '=', task_id)]"/>
                                    <field name="unit_amount" widget="float_time" decoration-danger="unit_amount &gt; 24"/>
                                </group>
                            </sheet>
                        </form>
                    </field>
                    <group class="oe_subtotal_footer oe_right">
                        <span>
                            <label class="font-weight-bold" for="normal_subtotal_hours" string="Normal Hours"/>
                        </span>
                        <field name="normal_subtotal_hours" widget="timesheet_uom" class="oe_subtotal_footer_separator" nolabel="1"/>
                        <span>
                            <label class="font-weight-bold" for="extra_subtotal_hours" string="Extra Hours"/>
                        </span>
                        <field name="extra_subtotal_hours" widget="timesheet_uom" class="oe_subtotal_footer_separator" nolabel="1"/>
                        <span>
                            <label class="font-weight-bold" for="total_hours" string="Total Hours"/>
                        </span>
                        <field name="total_hours" widget="timesheet_uom" class="oe_subtotal_footer_separator" nolabel="1"/>
                    </group>
                </page>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page invisible="task_type != 'partial'" string="Parts" name="partial_parts">
                    <field  name="partial_task_ids" options="{'no_create': True, 'no_open': True}">
                        <list>
                            <field name="name"/>
                            <field name="task_type"/>
                        </list>
                    </field>
                </page>
            </xpath>
            <xpath expr="//button[@name='create_renting_subtask']" position="before">
                <field name="create_all_renting"
                    groups="binhex_andamios.group_scaffold_admin"
                    invisible="hide_create_renting_subtask_button == True"
                />
            </xpath>
        </field>
    </record>

    <record id="project_task_inherit_tree" model="ir.ui.view">
        <field name="name">project.task.inherit.list</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='project_id']" position="after">
                <field name="description"/>
            </xpath>
        </field>
    </record>
</odoo>
