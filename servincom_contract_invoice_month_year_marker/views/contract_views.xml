            <xpath expr="//p[.//strong[normalize-space() = '#INVOICEMONTHNAME#']]" position="after">
                <div class="mt-3">
                    <div class="mb-2">
                        <strong>#INVOICEMONTHYEAR#</strong>: Nombre del mes y año del período facturado
                    </div>
                    <div>
                        <strong>#YEAR#</strong>: Año del período facturado
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
