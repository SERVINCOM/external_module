<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_template_form_inherit_invoice_month_year_marker" model="ir.ui.view">
        <field name="name">contract.template.form.inherit.invoice.month.year.marker</field>
        <field name="model">contract.template</field>
        <field name="inherit_id" ref="contract.contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//p[.//strong[normalize-space() = '#INVOICEMONTHNAME#']]" position="after">
                <div class="mt-3">
                    <div class="mb-2">
                        <strong>#INVOICEMONTHYEAR#</strong>: Nombre del mes y año del período facturado
                    </div>
                    <div>
                        <strong>#YEAR#</strong>: Año del período facturado
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_contract_customer_form_inherit_invoice_month_year_marker" model="ir.ui.view">
