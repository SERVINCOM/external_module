<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_contract_template_form_inherit_invoice_month_year_marker" model="ir.ui.view">
        <field name="name">contract.template.form.inherit.invoice.month.year.marker</field>
        <field name="model">contract.template</field>
        <field name="inherit_id" ref="contract.contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_legend']" position="replace">
                <group name="group_legend" string="LEYENDA (PARA LOS MARCADORES DENTRO DE DESCRIPCIÓN EN LINEAS DE FACTURA)">
                    <div colspan="2">
                        <p><strong>#START#</strong>: Fecha de inicio del periodo facturado</p>
                        <p><strong>#END#</strong>: Fecha final del periodo facturado</p>
                        <p><strong>#INVOICEMONTHNAME#</strong>: Nombre del mes del periodo facturado</p>
                        <p><strong>#INVOICEMONTHYEAR#</strong>: Nombre del mes y año del período facturado</p>
                        <p><strong>#YEAR#</strong>: Año del período facturado</p>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

