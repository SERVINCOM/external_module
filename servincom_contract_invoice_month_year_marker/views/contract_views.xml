                    <div class="mb-2">
                        <strong>#INVOICEMONTHYEAR#</strong>: Nombre del mes y año del período facturado
                    </div>
                    <div>
                        <strong>#YEAR#</strong>: Año del período facturado
                    </div>
                </div>
            </xpath>
        </field>
    </record>

    <record id="view_contract_supplier_form_inherit_invoice_month_year_marker" model="ir.ui.view">
        <field name="name">contract.contract.supplier.form.inherit.invoice.month.year.marker</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_supplier_form_view"/>
