<odoo>
  <data>
    <record id="binhex_purchase_order_scaffold" model="ir.ui.view">
        <field name="name">binhex.purchase.order.scaffold</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
          <xpath expr="//field[@name='partner_ref']" position="after">
              <field name="autofill_task"/>
          </xpath>
			    <xpath expr="//page[@name='products']" position="before">
            <page string="Tasks" name="tasks">
              <field name="cubic_meters_tasks">
						    <list editable="bottom">
						      <field name="name"/>                  
						    </list>
					    </field>
				    </page>
          </xpath>	
        </field>
    </record>
  </data>
</odoo>