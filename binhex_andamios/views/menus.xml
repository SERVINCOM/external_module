<odoo>
  <data>

    <!-- ACCIONES DE VENTANA -->
    <record model="ir.actions.act_window" id="andamios_action_window">
      <field name="name">Scaffolds list</field>
      <field name="res_model">scaffold.scaffold</field>
      <field name="view_mode">list,form,kanban</field>
      <field name="domain">[('parent_id', '=', False)]</field>
    </record>

    <record id="scaffold_stages_action_tree" model="ir.actions.act_window" >
        <field name="name">Stages</field>
        <field name="res_model">scaffold.stage</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="scaffold_zone_action_tree" model="ir.actions.act_window" >
        <field name="name">Zones</field>
        <field name="res_model">scaffold.zone</field>
        <field name="view_mode">list</field>
    </record>

    <!-- MENÚ PRINCIPAL-->
    <menuitem name="Scaffolds"
      id="menu_root"
      groups="group_scaffold_admin,group_scaffold_technician"
      web_icon="binhex_andamios,static/description/odoo_icon.png"/>

    <!-- ELEMENTOS DE MENÚ  -->
    <menuitem name="Scaffolds list"
        id="andamio_menu"
        parent="binhex_andamios.menu_root"
        groups="group_scaffold_admin,group_scaffold_technician"
        action="andamios_action_window"
        sequence="1"/>
    <menuitem name="Configuration"
        id="menu_scaffold_configuration"
        parent="menu_root"
        groups="group_scaffold_admin"
        sequence="99"/>

    <!-- SUB-ELEMENTOS DEL MENU DE CONFIGURACION-->
    <menuitem
        action="scaffold_stages_action_tree"
        parent="menu_scaffold_configuration"
        id="menu_event_scaffold_stages"
        groups="group_scaffold_admin"/>
    <menuitem
        action="scaffold_zone_action_tree"
        parent="menu_scaffold_configuration"
        id="menu_event_scaffold_zone"
        groups="group_scaffold_admin"/>
    </data>
</odoo>
