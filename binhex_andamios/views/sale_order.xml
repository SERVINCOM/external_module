<odoo>
  <data>
        <record id="scaffold_sale_order_view_button" model="ir.ui.view">
            <field name="name">scaffold.sale.order.view.button</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button
                        name="action_create_scaffold"
                        string="Crear andamio"
                        type="object"
                        invisible="state not in ['done', 'sale']"
                    />
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
                        name="action_show_andamios_treeview"
                        type="object" class="oe_stat_button"
                        icon="fa-cubes icon">
                            <div class="o_form_field o_stat_info">
                                <span class="o_stat_value">
                                    <field name="andamio_ids_size" widget="statinfo" string="Andamios"/>
                                </span>
                                <span class="o_stat_text">Scaffolds</span>
                            </div>
                    </button>
                </xpath>
                <xpath expr="//field[@name='order_line']" position="attributes">
                    <attribute name="context">{'partner_id': partner_id}</attribute>
                </xpath>
                <xpath expr="//list" position="attributes">
                    <attribute name="decoration-danger">state == 'sale' and rental == True and (rental_qty_delivered &lt; rental_qty or user_value_delivered &lt; user_value) </attribute>
                </xpath>
                <xpath expr="//list/field[@name='product_id']" position="after">
                    <field name="rental" column_invisible="1"/>
                    <field name="rental_qty" column_invisible="1"/>
                    <field name="rental_qty_delivered" column_invisible="1"/>
                    <field name="order_partner_id" column_invisible=""/>
                    <field name="scaffold_id" context="{'partner_id':order_partner_id}"/>
                </xpath>
                <xpath expr="//list/field[@name='product_uom_qty']" position="replace">
                    <field name="product_uom_qty" column_invisible="1"/>
                    <field name="user_value"/>
                </xpath>
                <xpath expr="//list/field[@name='qty_delivered']" position="replace">
                    <field name="qty_delivered" column_invisible="1"/>
                    <field name="user_value_delivered"/>
                </xpath>


                <xpath expr="//form/group/group/field[@name='product_type']" position="before">
                    <field name="order_partner_id" invisible="1"/>
                    <field name="must_have_dates" invisible="1"/>
                    <field name="product_uom_readonly" invisible="1"/>
                    <field name="display_type" invisible="1"/>

                    <field name="scaffold_id" context="{'partner_id':order_partner_id}"/>
                    <field name="start_date"
                        required="must_have_dates == True"/>
                    <field name="end_date"
                        required="must_have_dates == True"/>

                    <label for="user_value"/>
                    <div class="o_row">
                        <field name="user_value" required="display_type == False"/>
                        <p> Days </p>
                        <!--<field name="product_uom" attrs="{'required': [('display_type', '=', False)]}"/> xanxus-->
                    </div>
                    <field name="user_value_delivered" invisible="parent.state not in ['sale', 'done']"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//label[@for='product_uom_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//div[@name='ordered_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//label[@for='qty_delivered']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='order_line']/form//div[@name='delivered_qty']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <!--
            <label for="qty_delivered" string="Delivered" attrs="{'invisible': [('parent.state', 'not in', ['sale', 'done'])]}"/>
            <div name="delivered_qty" attrs="{'invisible': [('parent.state', 'not in', ['sale', 'done'])]}">
                <field name="qty_delivered" attrs="{'readonly': [('qty_delivered_method', '!=', 'manual')]}"/>
            </div>
        -->
        <record id="sale_start_end_dates.view_order_form" model="ir.ui.view">
            <field name="name">start.end.dates.view_order_form</field>
            <field name="model">sale.order</field>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/form//field[@name='product_id']" position="after">
                    <field name="start_date" invisible="1"/>
                    <field name="end_date" invisible="1"/>
                    <field name="number_of_days" invisible="1"/>
                    <field name="must_have_dates" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='order_line']/list/field[@name='name']" position="after">
                    <field name="start_date" column_invisible="1"/>
                    <field name="end_date" column_invisible="1"/>
                    <field name="number_of_days" column_invisible="1"/>
                    <field name="must_have_dates" column_invisible="1"/>
                </xpath>
                <field name="payment_term_id" position="after">
                    <field name="default_start_date"/>
                    <field name="default_end_date"/>
                </field>
            </field>
        </record>

        <record id="view_order_form" model="ir.ui.view">
            <field name="name">sale_rental.view_order_form</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale_rental.sale_rental_view_order_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='order_line']/form//field[@name='start_date']" position="after">
                    <field name="rental" invisible="1"/>
                    <field name="rental_qty" invisible="not rental"/>
                    <field
                            name="rental_qty_delivered"
                            invisible="not rental"
                        />
                </xpath>
            </field>
        </record>
    </data>
</odoo>
