<odoo>
    <record id="binhex_account_move_scaffold" model="ir.ui.view">
        <field name="name">binhex.account.move.scaffold</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account_payment_partner.view_move_form"/>
        <field name="arch" type="xml">
		      <xpath expr="//page[@id='invoice_tab']" position="before">
            <page string="Tasks" name="tasks" invisible="boolean_task == False">
                <field name="cubic_meters_tasks"
                domain="[('project_id','=',context.get('project_ref_id', project_id)), ('id', 'not in', cubic_meters_tasks), ('is_parent', '=', False)]"
                context="{'search_default_no_invoiced':1, 'search_default_project': 1}">
                <list editable="bottom">
                  <field name="name"/>
                  <field name="assembly_date"/>
                  <field name="disassembly_date"/>
                  <field name="cubic_meters"/>
                </list>
              </field>
            </page>
          </xpath>
          <xpath expr="//field[@name='payment_mode_id']" position="before">
            <field name="boolean_task"/>
            <field name="project_id" readonly="1"/>
          </xpath>
          <xpath expr="//field[@name='invoice_line_ids']/list" position="attributes">
            <attributes name="editable"/>
          </xpath>
        </field>
    </record>
</odoo>
