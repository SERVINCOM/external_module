<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="servincom_account_dashboard.MonthlySummary">
        <div class="o_servincom_compact" t-if="state.data">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span><strong t-esc="state.data.year"/> · <t t-esc="state.data.company"/> · <t t-esc="state.data.currency"/></span>
                <button class="btn btn-light" t-on-click="load">Refresh</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm o_servincom_summary_table">
                    <thead><tr><th scope="col">Concept</th>
                        <th t-foreach="state.data.months" t-as="month" t-key="month" scope="col" t-esc="month.slice(0, 3)" t-att-title="month"/>
                        <th scope="col">Annual total</th>
                    </tr></thead>
                    <tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.key" t-att-class="row.key === 'monthly_result' ? 'o_servincom_result' : ''">
                        <th scope="row" t-esc="row.label"/>
                        <td t-foreach="row.cells" t-as="cell" t-key="cell_index">
                            <button t-if="cell.drilldown" class="o_servincom_amount" t-on-click="() => this.drilldown(cell)" t-esc="amount(cell.value)" title="Open journal items"/>
                            <span t-else="" t-esc="amount(cell.value)"/>
                        </td>
                    </tr></tbody>
                </table>
            </div>
            <p class="text-muted mb-0">Same totals and filters as the detailed monthly results below.</p>
        </div>
    </t>

    <t t-name="servincom_account_dashboard.Analysis">
        <div class="o_servincom_analysis h-100 overflow-auto">
            <header class="o_servincom_analysis_header">
                <div><h2 t-esc="title"/><p t-if="state.data" class="text-muted mb-0"><t t-esc="state.data.company"/> · <t t-esc="state.data.currency"/></p></div>
                <form class="d-flex gap-2 align-items-end flex-wrap" t-on-submit.prevent="load">
                    <label>Year<input class="form-control" type="number" min="1901" max="9998" required="required" t-model="state.year"/></label>
                    <label t-if="state.data">Through month<select class="form-select" t-model="state.endMonth"><option t-foreach="state.data.months" t-as="month" t-key="month" t-att-value="month_index + 1" t-esc="month"/></select></label>
                    <label t-if="customers and state.data">Salesperson<select class="form-select" t-model="state.salesperson"><option value="">All</option><option t-foreach="state.data.salespeople" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label>
                    <button class="btn btn-primary" type="submit" t-att-disabled="state.loading">Apply</button>
                </form>
            </header>
            <div class="o_servincom_analysis_body" t-att-aria-busy="state.loading ? 'true' : 'false'">
                <p t-if="state.loading" role="status">Loading report…</p>
                <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
                <t t-if="state.data and !state.loading">
                    <t t-set="data" t-value="state.data"/>
                    <div class="alert alert-info" t-if="!data.ready">
                        <t t-if="customers">This period has not started yet. Select a year with recorded invoices.</t>
                        <t t-else="" t-esc="data.message"/>
                    </div>
                    <t t-if="data.ready">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <p class="o_servincom_period mb-0"><t t-if="!customers || state.showCurrent">01/01/<t t-esc="data.year"/> – <t t-esc="date(data.cutoff)"/></t><span t-if="!customers || bothYears" class="text-muted mx-2">vs.</span><t t-if="!customers || state.showPrevious">01/01/<t t-esc="data.previous_year"/> – <t t-esc="date(data.previous_cutoff)"/></t></p>
                            <div t-if="customers" class="o_servincom_years" role="group" aria-label="Visible years">
                                <span>Show years</span>
                                <label class="o_previous"><input type="checkbox" t-att-checked="state.showPrevious" t-att-disabled="!state.showCurrent" t-on-change="() => this.toggleYear('showPrevious')"/><t t-esc="data.previous_year"/></label>
                                <label class="o_current"><input type="checkbox" t-att-checked="state.showCurrent" t-att-disabled="!state.showPrevious" t-on-change="() => this.toggleYear('showCurrent')"/><t t-esc="data.year"/></label>
                            </div>
                        </div>
                        <t t-if="customers">
                            <div class="o_servincom_kpis" t-att-class="!bothYears ? 'o_two' : ''">
                                <button t-foreach="cards" t-as="card" t-key="card.key" class="o_servincom_kpi" t-att-class="'o_tone_' + card.tone" t-on-click="() => this.setFilter(card.key)">
                                    <span t-esc="card.label"/><strong t-esc="card.value"/>
                                </button>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="alert alert-info" t-esc="data.message"/>
                            <div class="o_servincom_kpis o_three">
                                <div t-foreach="data.rows" t-as="row" t-key="row.key" class="o_servincom_kpi">
                                    <span t-esc="row.label"/><strong t-esc="amount(row.cells[12].current)"/>
                                    <small><t t-esc="data.previous_year"/>: <t t-esc="amount(row.cells[12].previous)"/> · Δ <t t-esc="percent(row.cells[12].percent)"/></small>
                                </div>
                            </div>
                        </t>
                        <section t-if="customers" class="o_servincom_panel mb-3">
                            <h3 class="mb-0"><button type="button" class="o_servincom_panel_toggle" t-att-aria-expanded="!state.collapsedPanels.sales ? 'true' : 'false'" t-on-click="() => this.togglePanel('sales')"><span aria-hidden="true" t-esc="state.collapsedPanels.sales ? '▸' : '▾'"/><span>Monthly net invoicing</span><small class="ms-auto"><t t-if="state.collapsedPanels.sales">Expand</t><t t-else="">Collapse</t></small></button></h3>
                            <div t-if="!state.collapsedPanels.sales" class="o_servincom_panel_content">
                            <div class="d-flex justify-content-end mb-2">
                                <label class="d-flex align-items-center gap-2">Scope<select class="form-select w-auto" t-model="state.salesScope"><option value="comparable">Comparable customers</option><option value="available">All available data</option></select></label>
                            </div>
                            <p class="text-muted" t-if="state.salesScope === 'comparable'"><t t-esc="data.comparable_customer_count"/> <span>customers in the same comparison group</span></p>
                            <p class="text-muted" t-else="">Available totals for each year; historical totals contain only imported matches.</p>
                            <t t-call="servincom_account_dashboard.AnalysisChart"><t t-set="plot" t-value="salesChart"/><t t-set="money" t-value="true"/><t t-set="chartKey" t-value="'sales'"/></t>
                            <div class="table-responsive"><table class="table o_servincom_detail_table o_servincom_sales_table">
                                <thead><tr><th scope="col">Month</th><th t-if="state.showPrevious" scope="col" t-esc="data.previous_year"/><th t-if="state.showCurrent" scope="col" t-esc="data.year"/><th t-if="compareSales" scope="col">Difference</th><th t-if="compareSales" scope="col">Change %</th></tr></thead>
                                <tbody><tr t-foreach="salesRows" t-as="row" t-key="row.index" t-att-class="row.index === 12 ? 'o_servincom_result' : ''"><th scope="row" t-esc="row.label"/><td t-if="state.showPrevious" t-esc="amount(row.previous)"/><td t-if="state.showCurrent" t-esc="amount(row.current)"/><td t-if="compareSales" t-esc="amount(row.delta)"/><td t-if="compareSales" t-esc="percent(row.percent)"/></tr></tbody>
                            </table></div>
                            </div>
                        </section>
                        <section class="o_servincom_panel mb-3">
                            <t t-set="mainChartKey" t-value="customers ? 'customers' : 'result'"/>
                            <h3 class="mb-0"><button type="button" class="o_servincom_panel_toggle" t-att-aria-expanded="!state.collapsedPanels[mainChartKey] ? 'true' : 'false'" t-on-click="() => this.togglePanel(mainChartKey)"><span aria-hidden="true" t-esc="state.collapsedPanels[mainChartKey] ? '▸' : '▾'"/><span><t t-if="customers"><t t-if="data.matched_history and bothYears">Comparable active customers per month</t><t t-else="">Active customers per month</t></t><t t-else="">Monthly result evolution</t></span><small class="ms-auto"><t t-if="state.collapsedPanels[mainChartKey]">Expand</t><t t-else="">Collapse</t></small></button></h3>
                            <div t-if="!state.collapsedPanels[mainChartKey]" class="o_servincom_panel_content">
                            <t t-call="servincom_account_dashboard.AnalysisChart"><t t-set="plot" t-value="chart"/><t t-set="money" t-value="!customers"/><t t-set="chartKey" t-value="mainChartKey"/></t>
                            <details t-if="customers"><summary>See number of customers per month</summary><p class="text-muted mt-3">Distinct customers with at least one positive invoice in each month. A customer can appear in several months.</p><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Month</th><th t-if="state.showPrevious" t-esc="data.previous_year"/><th t-if="state.showCurrent" t-esc="data.year"/></tr></thead><tbody><tr t-foreach="customerTrend" t-as="point" t-key="point.month"><th t-esc="data.months[point.month - 1]"/><td t-if="state.showPrevious" t-esc="point.previous ?? '—'"/><td t-if="state.showCurrent" t-esc="point.current ?? '—'"/></tr></tbody></table></div></details>
                            </div>
                        </section>
                        <section class="o_servincom_panel" t-if="customers">
                            <div class="d-flex gap-2 flex-wrap align-items-center mb-3">
                                <h3 class="me-auto mb-0">Customer detail</h3>
                                <button class="btn btn-light" t-on-click="() => this.setFilter('all')">All</button>
                                <select t-if="bothYears" class="form-select w-auto" t-model="state.filter" t-on-change="() => { this.state.page = 0; }" aria-label="Customer status">
                                    <option value="all">All situations</option><option value="active">Active customers</option><option value="decline">Purchases down</option><option value="no_purchase">No purchases in period</option><option value="new">First recorded purchase</option><option value="recovered">Buying again</option><option value="growth">Purchases up</option><option value="stable">Unchanged</option><option value="credits">Credit notes only</option><option value="unavailable">No comparable data</option>
                                </select>
                                <input class="form-control w-auto" type="search" placeholder="Find customer" t-att-value="state.search" t-on-input="search"/>
                            </div>
                            <div class="table-responsive"><table class="table o_servincom_detail_table">
                                <thead><tr><th t-foreach="columns" t-as="column" t-key="column.key" scope="col" t-att-aria-sort="sortAria(column.key)"><button class="o_servincom_sort" type="button" t-on-click="() => this.sortBy(column.key)" title="Sort by this column"><t t-esc="column.label"/> <span aria-hidden="true" t-esc="sortIcon(column.key)"/></button></th><th scope="col">Detail</th></tr></thead>
                                <tbody><tr t-foreach="pageRows" t-as="row" t-key="row.id"><th scope="row" t-esc="row.name"/><td t-if="state.showPrevious" t-esc="amount(row.previous)"/><td t-if="state.showCurrent" t-esc="amount(row.current)"/><td t-if="bothYears" t-esc="amount(row.delta)"/><td t-if="bothYears" t-esc="percent(row.percent)"/><td t-esc="date(lastPurchase(row))"/><td t-if="bothYears"><span class="o_servincom_status" t-att-class="'o_status_' + row.status" t-esc="row.status_label"/></td><td><button t-if="canOpenDocuments(row, false)" class="btn btn-sm btn-outline-primary" t-on-click="() => this.openInvoices(row)">View invoices</button><button t-if="canOpenDocuments(row, true)" class="btn btn-sm btn-outline-secondary ms-1" t-on-click="() => this.openHistory(row)">View history</button></td></tr>
                                <tr t-if="!filteredRows.length"><td t-att-colspan="columns.length + 1">No customers match these filters.</td></tr></tbody>
                            </table></div>
                            <nav class="o_servincom_pager" aria-label="Customer pages">
                                <span class="me-auto" t-esc="pageRange"/>
                                <button class="btn btn-light" t-att-disabled="pageCount &lt;= 1" t-on-click="() => this.movePage(-1)" title="Previous page; from the first page, go to the last">Previous</button>
                                <label class="d-flex align-items-center gap-2">Page<input class="form-control" type="number" min="1" t-att-max="pageCount || 1" t-att-value="pageCount ? pageIndex + 1 : 0" t-att-disabled="!pageCount" t-on-change="jumpPage"/></label>
                                <span>of</span><strong t-esc="pageCount"/>
                                <button class="btn btn-light" t-att-disabled="pageCount &lt;= 1" t-on-click="() => this.movePage(1)" title="Next page; from the last page, go to the first">Next</button>
                            </nav>
                        </section>
                        <section class="o_servincom_panel" t-else="">
                            <h3>Monthly comparison</h3>
                            <div class="table-responsive"><table class="table o_servincom_detail_table">
                                <thead><tr><th rowspan="2" scope="col">Month</th><th colspan="2" scope="colgroup">Income</th><th colspan="2" scope="colgroup">Purchases and expenses</th><th colspan="4" scope="colgroup">Result</th></tr><tr><t t-foreach="[0, 1, 2]" t-as="column" t-key="column"><th scope="col" t-esc="data.previous_year"/><th scope="col" t-esc="data.year"/></t><th scope="col">Difference</th><th scope="col">Change %</th></tr></thead>
                                <tbody><tr t-foreach="comparisonRows" t-as="row" t-key="row.index" t-att-class="row.index === 12 ? 'o_servincom_result' : ''"><th scope="row" t-esc="row.label"/><td t-esc="amount(row.income.previous)"/><td t-esc="amount(row.income.current)"/><td t-esc="amount(row.expense.previous)"/><td t-esc="amount(row.expense.current)"/><td t-esc="amount(row.result.previous)"/><td t-esc="amount(row.result.current)"/><td t-esc="amount(row.result.delta)"/><td t-esc="percent(row.result.percent)"/></tr></tbody>
                            </table></div>
                        </section>
                        <footer class="o_servincom_notes">
                            <p t-if="customers and data.history_message" t-esc="data.history_message"/>
                            <p t-if="customers">Monthly invoicing is untaxed and net of credit notes. Comparable customers uses the same customer group in both years. All available data includes customers without a comparison, so differences are not calculated for that scope. Customer search and situation filters only affect the detail table.</p>
                            <p t-if="customers and !bothYears">With one year visible, customer counts include all available customers in that year and the last purchase is limited to its selected period.</p>
                            <p t-if="customers">Posted customer invoices, untaxed and net of credit notes, in company currency. Contacts are grouped by commercial customer. Active means at least one positive invoice; credit notes alone are not a purchase. First recorded purchase depends on the available invoice history. Last purchase is measured up to the cutoff across all salespeople. No purchase does not mean a lost customer.</p>
                            <p t-else="">Same MIS formulas and journal exclusions as monthly results. Months after the cutoff are not forecasts. An empty prior period cannot be treated as a zero baseline.</p>
                            <p>Percent change is shown only when the previous amount is positive. Figures follow your access permissions.</p>
                        </footer>
                    </t>
                </t>
            </div>
        </div>
    </t>
    <t t-name="servincom_account_dashboard.AnalysisChart">
        <div class="o_servincom_legend" role="group" aria-label="Years shown in this chart">
            <button t-if="!customers || state.showCurrent" type="button" class="o_current" t-att-class="!chartYearVisible(chartKey, 'current') ? 'o_series_hidden' : ''" t-att-aria-pressed="chartYearVisible(chartKey, 'current') ? 'true' : 'false'" title="Show or hide this year in this chart" t-on-click="() => this.toggleChartYear(chartKey, 'current')" t-esc="data.year"/>
            <button t-if="!customers || state.showPrevious" type="button" class="o_previous" t-att-class="!chartYearVisible(chartKey, 'previous') ? 'o_series_hidden' : ''" t-att-aria-pressed="chartYearVisible(chartKey, 'previous') ? 'true' : 'false'" title="Show or hide this year in this chart" t-on-click="() => this.toggleChartYear(chartKey, 'previous')" t-esc="data.previous_year"/>
        </div>
        <p t-if="!plot.hasVisibleSeries" class="text-muted my-4">Select a year in the chart legend to display its data.</p>
        <svg t-else="" class="o_servincom_chart" viewBox="0 0 880 215" role="img" aria-label="Monthly evolution">
            <line x1="105" x2="840" t-att-y1="plot.zero" t-att-y2="plot.zero" stroke="#d3dde5"/>
            <text x="5" y="22" class="o_axis" t-esc="money ? amount(plot.max) : plot.max"/>
            <text x="5" y="190" class="o_axis" t-esc="money ? amount(plot.min) : plot.min"/>
            <polyline t-att-points="plot.previousLine" fill="none" stroke="#98a9b8" stroke-width="3" stroke-dasharray="6 4"/>
            <polyline t-att-points="plot.currentLine" fill="none" stroke="#239d91" stroke-width="3"/>
            <circle t-foreach="plot.previous" t-as="point" t-key="point.index" t-att-cx="point.x" t-att-cy="point.y" r="4" fill="#98a9b8"><title><t t-esc="data.months[point.index]"/> · <t t-esc="data.previous_year"/>: <t t-esc="money ? amount(point.value) : point.value"/></title></circle>
            <circle t-foreach="plot.current" t-as="point" t-key="point.index" t-att-cx="point.x" t-att-cy="point.y" r="4" fill="#239d91"><title><t t-esc="data.months[point.index]"/> · <t t-esc="data.year"/>: <t t-esc="money ? amount(point.value) : point.value"/></title></circle>
            <text t-foreach="data.months" t-as="month" t-key="month" t-att-x="110 + month_index * 65" y="210" text-anchor="middle" class="o_axis" t-esc="month.slice(0, 3)"/>
        </svg>
    </t>
</templates>
