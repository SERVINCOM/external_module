<?xml version="1.0" encoding="utf-8"?>
<templates xml:space="preserve">
    <t t-name="servincom_account_dashboard.MonthlySummary">
        <div class="o_servincom_compact" t-if="state.data">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span><strong t-esc="state.data.year"/> · <t t-esc="state.data.company"/> · <t t-esc="state.data.currency"/></span>
                <button class="btn btn-light" t-on-click="load">Refresh</button>
            </div>
            <div class="table-responsive">
                <table class="table table-sm o_servincom_summary_table">
                    <thead><tr><th scope="col">Concept</th>
                        <th t-foreach="state.data.months" t-as="month" t-key="month" scope="col" t-esc="month.slice(0, 3)" t-att-title="month"/>
                        <th scope="col">Annual total</th>
                    </tr></thead>
                    <tbody><tr t-foreach="state.data.rows" t-as="row" t-key="row.key" t-att-class="row.key === 'monthly_result' ? 'o_servincom_result' : ''">
                        <th scope="row" t-esc="row.label"/>
                        <td t-foreach="row.cells" t-as="cell" t-key="cell_index">
                            <button t-if="cell.drilldown" class="o_servincom_amount" t-on-click="() => this.drilldown(cell)" t-esc="amount(cell.value)" title="Open journal items"/>
                            <span t-else="" t-esc="amount(cell.value)"/>
                        </td>
                    </tr></tbody>
                </table>
            </div>
            <p class="text-muted mb-0">Same totals and filters as the detailed monthly results below.</p>
        </div>
    </t>

    <t t-name="servincom_account_dashboard.Analysis">
        <div class="o_servincom_analysis h-100 overflow-auto">
            <header class="o_servincom_analysis_header">
                <div><h2 t-esc="title"/><p t-if="state.data" class="text-muted mb-0"><t t-esc="state.data.company"/> · <t t-esc="state.data.currency"/></p></div>
                <form class="d-flex gap-2 align-items-end flex-wrap" t-on-submit.prevent="load">
                    <label>Year<input class="form-control" type="number" min="1901" max="9998" required="required" t-model="state.year"/></label>
                    <label t-if="state.data">Through month<select class="form-select" t-model="state.endMonth"><option t-foreach="state.data.months" t-as="month" t-key="month" t-att-value="month_index + 1" t-esc="month"/></select></label>
                    <label t-if="customers and state.data">Salesperson<select class="form-select" t-model="state.salesperson"><option value="">All</option><option t-foreach="state.data.salespeople" t-as="person" t-key="person.id" t-att-value="person.id" t-esc="person.name"/></select></label>
                    <button class="btn btn-primary" type="submit" t-att-disabled="state.loading">Apply</button>
                </form>
            </header>
            <div class="o_servincom_analysis_body" t-att-aria-busy="state.loading ? 'true' : 'false'">
                <p t-if="state.loading" role="status">Loading report…</p>
                <div t-if="state.error" class="alert alert-danger" role="alert" t-esc="state.error"/>
                <t t-if="state.data and !state.loading">
                    <t t-set="data" t-value="state.data"/>
                    <div class="alert alert-info" t-if="!data.ready">
                        <t t-if="customers">This period has not started yet. Select a year with recorded invoices.</t>
                        <t t-else="" t-esc="data.message"/>
                    </div>
                    <t t-if="data.ready">
                        <p class="o_servincom_period">01/01/<t t-esc="data.year"/> – <t t-esc="date(data.cutoff)"/> <span class="text-muted mx-2">vs.</span> 01/01/<t t-esc="data.previous_year"/> – <t t-esc="date(data.previous_cutoff)"/></p>
                        <t t-if="customers">
                            <p t-if="data.history_message" class="alert alert-info" t-esc="data.history_message"/>
                            <div class="o_servincom_kpis">
                                <button t-foreach="cards" t-as="card" t-key="card.key" class="o_servincom_kpi" t-att-class="'o_tone_' + card.tone" t-on-click="() => this.setFilter(card.key)">
                                    <span t-esc="card.label"/><strong t-esc="card.value"/>
                                </button>
                            </div>
                        </t>
                        <t t-else="">
                            <p class="alert alert-info" t-esc="data.message"/>
                            <div class="o_servincom_kpis o_three">
                                <div t-foreach="data.rows" t-as="row" t-key="row.key" class="o_servincom_kpi">
                                    <span t-esc="row.label"/><strong t-esc="amount(row.cells[12].current)"/>
                                    <small><t t-esc="data.previous_year"/>: <t t-esc="amount(row.cells[12].previous)"/> · Δ <t t-esc="percent(row.cells[12].percent)"/></small>
                                </div>
                            </div>
                        </t>
                        <section class="o_servincom_panel mb-3">
                            <t t-if="customers"><h3 t-if="data.matched_history">Comparable active customers per month</h3><h3 t-else="">Active customers per month</h3></t><h3 t-else="">Monthly result evolution</h3>
                            <div class="o_servincom_legend"><span class="o_current" t-esc="data.year"/><span class="o_previous" t-esc="data.previous_year"/></div>
                            <t t-set="plot" t-value="chart"/>
                            <svg class="o_servincom_chart" viewBox="0 0 880 215" role="img" aria-label="Monthly evolution">
                                <line x1="40" x2="840" t-att-y1="plot.zero" t-att-y2="plot.zero" stroke="#d3dde5"/>
                                <text x="5" y="22" class="o_axis" t-esc="customers ? plot.max : amount(plot.max)"/>
                                <text x="5" y="190" class="o_axis" t-esc="customers ? plot.min : amount(plot.min)"/>
                                <polyline t-att-points="plot.previousLine" fill="none" stroke="#98a9b8" stroke-width="3" stroke-dasharray="6 4"/>
                                <polyline t-att-points="plot.currentLine" fill="none" stroke="#239d91" stroke-width="3"/>
                                <circle t-foreach="plot.previous" t-as="point" t-key="point.index" t-att-cx="point.x" t-att-cy="point.y" r="4" fill="#98a9b8"><title><t t-esc="data.months[point.index]"/> · <t t-esc="data.previous_year"/>: <t t-esc="customers ? point.value : amount(point.value)"/></title></circle>
                                <circle t-foreach="plot.current" t-as="point" t-key="point.index" t-att-cx="point.x" t-att-cy="point.y" r="4" fill="#239d91"><title><t t-esc="data.months[point.index]"/> · <t t-esc="data.year"/>: <t t-esc="customers ? point.value : amount(point.value)"/></title></circle>
                                <text t-foreach="data.months" t-as="month" t-key="month" t-att-x="48 + month_index * 71" y="210" text-anchor="middle" class="o_axis" t-esc="month.slice(0, 3)"/>
                            </svg>
                            <details t-if="customers"><summary>See monthly counts</summary><div class="table-responsive"><table class="table table-sm"><thead><tr><th>Month</th><th t-esc="data.previous_year"/><th t-esc="data.year"/></tr></thead><tbody><tr t-foreach="data.trend" t-as="point" t-key="point.month"><th t-esc="data.months[point.month - 1]"/><td t-esc="point.previous ?? '—'"/><td t-esc="point.current ?? '—'"/></tr></tbody></table></div></details>
                        </section>
                        <section class="o_servincom_panel" t-if="customers">
                            <div class="d-flex gap-2 flex-wrap align-items-center mb-3">
                                <h3 class="me-auto mb-0">Customer detail</h3>
                                <button class="btn btn-light" t-on-click="() => this.setFilter('all')">All</button>
                                <select class="form-select w-auto" t-model="state.filter" t-on-change="() => { this.state.page = 0; }" aria-label="Customer status">
                                    <option value="all">All situations</option><option value="active">Active customers</option><option value="decline">Purchases down</option><option value="no_purchase">No purchases in period</option><option value="new">First recorded purchase</option><option value="recovered">Buying again</option><option value="growth">Purchases up</option><option value="stable">Unchanged</option><option value="credits">Credit notes only</option><option value="unavailable">No comparable data</option>
                                </select>
                                <input class="form-control w-auto" type="search" placeholder="Find customer" t-att-value="state.search" t-on-input="search"/>
                            </div>
                            <div class="table-responsive"><table class="table o_servincom_detail_table">
                                <thead><tr><th scope="col">Customer</th><th scope="col" t-esc="data.previous_year"/><th scope="col" t-esc="data.year"/><th scope="col">Change</th><th scope="col">Change %</th><th scope="col">Last purchase</th><th scope="col">Situation</th><th scope="col">Detail</th></tr></thead>
                                <tbody><tr t-foreach="pageRows" t-as="row" t-key="row.id"><th scope="row" t-esc="row.name"/><td t-esc="amount(row.previous)"/><td t-esc="amount(row.current)"/><td t-esc="amount(row.delta)"/><td t-esc="percent(row.percent)"/><td t-esc="date(row.last_purchase)"/><td><span class="o_servincom_status" t-att-class="'o_status_' + row.status" t-esc="row.status_label"/></td><td><button class="btn btn-sm btn-outline-primary" t-on-click="() => this.openInvoices(row)">View invoices</button><button t-if="row.has_history" class="btn btn-sm btn-outline-secondary ms-1" t-on-click="() => this.openHistory(row)">View history</button></td></tr>
                                <tr t-if="!filteredRows.length"><td colspan="8">No customers match these filters.</td></tr></tbody>
                            </table></div>
                            <div class="d-flex justify-content-end align-items-center gap-2"><span t-esc="filteredRows.length"/><span>customers</span><button class="btn btn-light" t-att-disabled="state.page === 0" t-on-click="() => { this.state.page--; }">Previous</button><span t-esc="state.page + 1"/><button class="btn btn-light" t-att-disabled="(state.page + 1) * pageSize >= filteredRows.length" t-on-click="() => { this.state.page++; }">Next</button></div>
                        </section>
                        <section class="o_servincom_panel" t-else="">
                            <h3>Monthly comparison</h3>
                            <div class="table-responsive"><table class="table o_servincom_detail_table">
                                <thead><tr><th rowspan="2" scope="col">Month</th><th colspan="2" scope="colgroup">Income</th><th colspan="2" scope="colgroup">Purchases and expenses</th><th colspan="4" scope="colgroup">Result</th></tr><tr><t t-foreach="[0, 1, 2]" t-as="column" t-key="column"><th scope="col" t-esc="data.previous_year"/><th scope="col" t-esc="data.year"/></t><th scope="col">Change</th><th scope="col">Change %</th></tr></thead>
                                <tbody><tr t-foreach="comparisonRows" t-as="row" t-key="row.index" t-att-class="row.index === 12 ? 'o_servincom_result' : ''"><th scope="row" t-esc="row.label"/><td t-esc="amount(row.income.previous)"/><td t-esc="amount(row.income.current)"/><td t-esc="amount(row.expense.previous)"/><td t-esc="amount(row.expense.current)"/><td t-esc="amount(row.result.previous)"/><td t-esc="amount(row.result.current)"/><td t-esc="amount(row.result.delta)"/><td t-esc="percent(row.result.percent)"/></tr></tbody>
                            </table></div>
                        </section>
                        <footer class="o_servincom_notes">
                            <p t-if="customers">Posted customer invoices, untaxed and net of credit notes, in company currency. Contacts are grouped by commercial customer. Active means at least one positive invoice; credit notes alone are not a purchase. First recorded purchase depends on the available invoice history. Last purchase is measured up to the cutoff across all salespeople. No purchase does not mean a lost customer.</p>
                            <p t-else="">Same MIS formulas and journal exclusions as monthly results. Months after the cutoff are not forecasts. An empty prior period cannot be treated as a zero baseline.</p>
                            <p>Percent change is shown only when the previous amount is positive. Figures follow your access permissions.</p>
                        </footer>
                    </t>
                </t>
            </div>
        </div>
    </t>
</templates>
