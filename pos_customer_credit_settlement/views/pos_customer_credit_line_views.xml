<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_customer_credit_line_tree" model="ir.ui.view">
        <field name="name">pos.customer.credit.line.tree</field>
        <field name="model">pos.customer.credit.line</field>
        <field name="arch" type="xml">
            <tree decoration-success="state == 'paid'" decoration-muted="state == 'cancelled'" decoration-warning="state == 'partial'">
                <field name="date_order"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <field name="amount_total" sum="Importe original"/>
                <field name="amount_paid" sum="Importe cobrado"/>
                <field name="amount_residual" sum="Pendiente"/>
                <field name="state" widget="badge"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_pos_customer_credit_line_form" model="ir.ui.view">
        <field name="name">pos.customer.credit.line.form</field>
        <field name="model">pos.customer.credit.line</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_cancel"
                        string="Cancelar"
                        type="object"
                        class="btn-secondary"
                        groups="pos_customer_credit_settlement.group_pos_customer_credit_manager"
                        attrs="{'invisible': [('state', '=', 'cancelled')]}"
                    />
                    <button
                        name="action_reopen"
                        string="Reabrir"
                        type="object"
                        class="btn-secondary"
                        groups="pos_customer_credit_settlement.group_pos_customer_credit_manager"
                        attrs="{'invisible': [('state', '!=', 'cancelled')]}"
                    />
                    <field name="state" widget="statusbar" statusbar_visible="open,partial,paid"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id" readonly="1"/>
                            <field name="pos_order_id" readonly="1"/>
                            <field name="date_order" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="config_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" readonly="1"/>
                            <field name="amount_paid" readonly="1"/>
                            <field name="amount_residual" readonly="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Cobros aplicados">
                            <field name="payment_line_ids" readonly="1">
                                <tree>
                                    <field name="payment_id"/>
                                    <field name="amount"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notas">
                            <field name="note"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_pos_customer_credit_line_search" model="ir.ui.view">
        <field name="name">pos.customer.credit.line.search</field>
        <field name="model">pos.customer.credit.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="pos_order_id"/>
                <field name="session_id"/>
                <field name="config_id"/>
                <filter name="pending" string="Pendientes" domain="[('state', 'in', ('open', 'partial'))]"/>
                <filter name="paid" string="Pagadas" domain="[('state', '=', 'paid')]"/>
                <filter name="cancelled" string="Canceladas" domain="[('state', '=', 'cancelled')]"/>
                <separator/>
                <filter name="group_partner" string="Cliente" context="{'group_by': 'partner_id'}"/>
                <filter name="group_state" string="Estado" context="{'group_by': 'state'}"/>
                <filter name="group_session" string="Sesión" context="{'group_by': 'session_id'}"/>
                <filter name="group_config" string="Punto de venta" context="{'group_by': 'config_id'}"/>
                <filter name="group_date" string="Fecha" context="{'group_by': 'date_order:day'}"/>
            </search>
        </field>
    </record>

    <record id="action_pos_customer_credit_line" model="ir.actions.act_window">
        <field name="name">Tickets pendientes</field>
        <field name="res_model">pos.customer.credit.line</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_pos_customer_credit_line_search"/>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
