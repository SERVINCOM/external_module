<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_payment_method_view_form_pos_customer_credit" model="ir.ui.view">
        <field name="name">pos.payment.method.form.pos.customer.credit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="Crédito clientes TPV">
                    <field name="is_pos_customer_credit"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="pos_payment_method_view_tree_pos_customer_credit" model="ir.ui.view">
        <field name="name">pos.payment.method.tree.pos.customer.credit</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='name']" position="after">
                <field name="is_pos_customer_credit" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
