<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_customer_credit_settlement.CreditButton" owl="1">
        <button class="control-button" t-on-click="onClick">
            <i class="fa fa-credit-card" role="img" aria-label="Cobrar deuda" title="Cobrar deuda"/>
            <span>Cobrar deuda</span>
        </button>
    </t>

    <t t-name="pos_customer_credit_settlement.PosCreditPaymentPopup" owl="1">
        <div class="popup popup-credit-payment">
            <div class="modal-header">
                <h4 class="modal-title"><t t-esc="props.title"/></h4>
            </div>
            <main class="modal-body" style="min-width: 820px; max-width: 980px;">
                <div class="d-flex gap-3">
                    <section style="width: 32%;">
                        <input
                            class="searchbox-client"
                            type="text"
                            placeholder="Buscar cliente"
                            t-att-value="state.query"
                            t-on-input="onQueryInput"
                        />
                        <div class="client-list" style="max-height: 360px; overflow: auto; margin-top: 8px;">
                            <t t-if="state.loading">
                                <div class="text-muted">Cargando...</div>
                            </t>
                            <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                                <button
                                    type="button"
                                    class="button customer-line"
                                    style="display: block; width: 100%; text-align: left; margin-bottom: 4px;"
                                    t-att-class="state.selectedPartner &amp;&amp; state.selectedPartner.id === customer.id ? 'button customer-line highlight' : 'button customer-line'"
                                    t-on-click="() => this.selectPartner(customer)"
                                >
                                    <strong><t t-esc="customer.name"/></strong>
                                    <br/>
                                    <small>
                                        <t t-esc="customer.vat || customer.ref || customer.phone"/>
                                        <t t-if="customer.ticket_count">
                                            · <t t-esc="customer.ticket_count"/> tickets ·
                                            <t t-esc="formatCurrency(customer.total_due)"/>
                                        </t>
                                    </small>
                                </button>
                            </t>
                        </div>
                    </section>

                    <section style="width: 68%;">
                        <t t-if="state.selectedPartner">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <strong><t t-esc="state.selectedPartner.name"/></strong>
                                <span>Total seleccionado: <strong><t t-esc="formatCurrency(selectedTotal)"/></strong></span>
                            </div>
                            <div style="max-height: 300px; overflow: auto;">
                                <table class="table table-sm">
                                    <thead>
                                        <tr>
                                            <th/>
                                            <th>Fecha</th>
                                            <th>Ticket</th>
                                            <th class="text-end">Original</th>
                                            <th class="text-end">Cobrado</th>
                                            <th class="text-end">Pendiente</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-if="!state.lines.length">
                                            <td colspan="6" class="text-center text-muted">Sin tickets pendientes</td>
                                        </tr>
                                        <t t-foreach="state.lines" t-as="line" t-key="line.id">
                                            <tr>
                                                <td>
                                                    <input
                                                        type="checkbox"
                                                        t-att-checked="state.selectedLineIds[line.id] ? true : undefined"
                                                        t-on-change="(event) => this.toggleLine(line, event)"
                                                    />
                                                </td>
                                                <td><t t-esc="line.date_order"/></td>
                                                <td><t t-esc="line.pos_order_name"/></td>
                                                <td class="text-end"><t t-esc="formatCurrency(line.amount_total)"/></td>
                                                <td class="text-end"><t t-esc="formatCurrency(line.amount_paid)"/></td>
                                                <td class="text-end"><t t-esc="formatCurrency(line.amount_residual)"/></td>
                                            </tr>
                                        </t>
                                    </tbody>
                                </table>
                            </div>
                            <div class="d-flex gap-2 align-items-end mt-3">
                                <label style="flex: 1;">
                                    Importe a cobrar
                                    <input
                                        type="number"
                                        step="0.01"
                                        min="0"
                                        class="form-control"
                                        t-att-value="state.amount"
                                        t-on-input="onAmountInput"
                                    />
                                </label>
                                <label style="flex: 1;">
                                    Método de cobro
                                    <select
                                        class="form-control"
                                        t-att-value="state.payment_method_id"
                                        t-on-change="onPaymentMethodChange"
                                    >
                                        <t t-foreach="paymentMethods" t-as="method" t-key="method.id">
                                            <option t-att-value="method.id">
                                                <t t-esc="method.name"/>
                                            </option>
                                        </t>
                                    </select>
                                </label>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="text-center text-muted" style="padding: 80px 20px;">
                                Seleccione un cliente de crédito.
                            </div>
                        </t>
                    </section>
                </div>
            </main>
            <footer class="footer modal-footer">
                <button class="button cancel" t-on-click="cancel">
                    <t t-esc="props.cancelText"/>
                </button>
                <button class="button confirm highlight" t-on-click="confirmPayment">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </div>
    </t>
</templates>
