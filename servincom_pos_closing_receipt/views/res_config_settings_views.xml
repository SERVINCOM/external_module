<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_receipt_options" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.receipt.options</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field
                            name="pos_servincom_hide_receipt_taxes"
                            attrs="{'readonly': [('pos_has_active_session', '=', True)]}"
                        />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_servincom_hide_receipt_taxes"
                            string="Retailer receipt without tax details"
                        />
                        <div class="text-muted">
                            Hide the tax breakdown and total taxes on the customer receipt.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field
                            name="pos_servincom_customize_receipt_operator"
                            attrs="{'readonly': [('pos_has_active_session', '=', True)]}"
                        />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_servincom_customize_receipt_operator"
                            string="Customize operator on customer receipt"
                        />
                        <div class="text-muted">
                            Keep Odoo's standard receipt when disabled. Enable it to choose how the operator is shown.
                        </div>
                        <div
                            class="content-group mt16"
                            attrs="{'invisible': [('pos_servincom_customize_receipt_operator', '=', False)]}"
                        >
                            <div class="mb8">
                                <label
                                    for="pos_servincom_receipt_operator_display"
                                    string="Operator shown on customer receipt"
                                />
                            </div>
                            <div>
                                <field
                                    name="pos_servincom_receipt_operator_display"
                                    widget="radio"
                                    attrs="{'readonly': [('pos_has_active_session', '=', True)]}"
                                />
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
