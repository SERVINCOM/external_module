<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_receipt_options" model="ir.ui.view">
        <field name="name">res.config.settings.form.pos.receipt.options</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='pos_interface_section']" position="inside">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field
                            name="pos_servincom_hide_receipt_taxes"
                            attrs="{'readonly': [('pos_has_active_session', '=', True)]}"
                        />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_servincom_hide_receipt_taxes"
                            string="Retailer receipt"
                        />
                        <div class="text-muted">
                            Do not show the tax breakdown or total taxes on the customer receipt.
                        </div>
                    </div>
                </div>
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane">
                        <field
                            name="pos_servincom_anonymize_receipt_operator"
                            attrs="{'readonly': [('pos_has_active_session', '=', True)]}"
                        />
                    </div>
                    <div class="o_setting_right_pane">
                        <label
                            for="pos_servincom_anonymize_receipt_operator"
                            string="Operator privacy"
                        />
                        <div class="text-muted">
                            Show the configured operator identifier instead of the full name.
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
