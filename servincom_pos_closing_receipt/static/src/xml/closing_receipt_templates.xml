<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="servincom_pos_closing_receipt.ClosingReceipt" owl="1">
        <div class="pos-receipt">
            <t t-if="pos.company_logo_base64">
                <img class="pos-receipt-logo" t-att-src="pos.company_logo_base64" alt="Logo"/>
                <br/>
            </t>
            <t t-if="!pos.company_logo_base64">
                <div class="pos-receipt-center-align">
                    <h1 t-esc="company_name"/>
                </div>
            </t>

            <div class="pos-receipt-center-align">
                <strong>Cierre de caja TPV</strong>
            </div>
            <br/>

            <div>Punto de venta: <span t-esc="pos_name"/></div>
            <div>Sesión TPV: <span t-esc="session_name"/></div>
            <div>Usuario/cajero: <span t-esc="cashier_name"/></div>
            <div>Fecha y hora: <span t-esc="date_time"/></div>

            <br/>
            <div>------------------------</div>
            <br/>

            <div>Total de pedidos:
                <span class="pos-receipt-right-align" t-esc="orders_count"/>
            </div>
            <div>Total vendido:
                <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(orders_total)"/>
            </div>

            <br/>
            <div>------------------------</div>
            <br/>

            <div><strong>Métodos de pago</strong></div>
            <t t-foreach="payment_methods" t-as="method" t-key="method_index">
                <div>
                    <span t-esc="method.name"/>
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(method.expected)"/>
                </div>
                <div class="pos-receipt-left-padding">
                    <span t-esc="method.category"/>
                </div>
                <t t-if="method.breakdown">
                    <div t-if="method.breakdown.sales_amount" class="pos-receipt-left-padding">
                        Ventas TPV
                        <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(method.breakdown.sales_amount)"/>
                    </div>
                    <t t-foreach="method.breakdown.credit_payments || []" t-as="credit" t-key="credit_index">
                        <div class="pos-receipt-left-padding">
                            Cobro deuda clientes <span t-esc="credit.name"/>
                            <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(credit.amount)"/>
                        </div>
                    </t>
                    <t t-foreach="method.breakdown.refunds || []" t-as="refund" t-key="refund_index">
                        <div class="pos-receipt-left-padding">
                            Reembolso <span t-esc="refund.name"/>
                            <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(refund.amount)"/>
                        </div>
                    </t>
                </t>
                <t t-if="method.show_counted">
                    <div class="pos-receipt-left-padding">
                        Contado
                        <span t-if="method.counted !== null" class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(method.counted)"/>
                        <span t-if="method.counted === null" class="pos-receipt-right-align">Sin indicar</span>
                    </div>
                    <div class="pos-receipt-left-padding">
                        Diferencia
                        <span t-if="method.difference !== null" class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(method.difference)"/>
                        <span t-if="method.difference === null" class="pos-receipt-right-align">Sin indicar</span>
                    </div>
                </t>
            </t>

            <br/>
            <div>------------------------</div>
            <br/>

            <div><strong>Efectivo</strong></div>
            <t t-if="cash.name">
                <div>Esperado:
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.expected)"/>
                </div>
                <div>Contado:
                    <span t-if="cash.counted !== null" class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.counted)"/>
                    <span t-if="cash.counted === null" class="pos-receipt-right-align">Sin indicar</span>
                </div>
                <div>Diferencia:
                    <span t-if="cash.difference !== null" class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.difference)"/>
                    <span t-if="cash.difference === null" class="pos-receipt-right-align">Sin indicar</span>
                </div>
                <br/>
                <div>Apertura:
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.opening)"/>
                </div>
                <div>Entradas de efectivo:
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.cash_in_total)"/>
                </div>
                <div>Salidas de efectivo:
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(Math.abs(cash.cash_out_total))"/>
                </div>
                <div>Pagos en efectivo:
                    <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.payment_amount)"/>
                </div>
                <t t-if="cash.breakdown">
                    <div t-if="cash.breakdown.sales_amount" class="pos-receipt-left-padding">
                        Ventas TPV
                        <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(cash.breakdown.sales_amount)"/>
                    </div>
                    <t t-foreach="cash.breakdown.refunds || []" t-as="refund" t-key="refund_index">
                        <div class="pos-receipt-left-padding">
                            Reembolso <span t-esc="refund.name"/>
                            <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(refund.amount)"/>
                        </div>
                    </t>
                </t>
                <t t-if="cash.moves.length">
                    <br/>
                    <div>Movimientos de caja:</div>
                    <t t-foreach="cash.moves" t-as="move" t-key="move_index">
                        <div class="pos-receipt-left-padding">
                            <span t-esc="move.name"/>
                            <span class="pos-receipt-right-align" t-esc="pos.format_currency_no_symbol(move.amount)"/>
                        </div>
                    </t>
                </t>
            </t>
            <t t-if="!cash.name">
                <div>Sin control de efectivo.</div>
            </t>

            <t t-if="opening_note">
                <br/>
                <div>------------------------</div>
                <br/>
                <div><strong>Nota de apertura</strong></div>
                <div t-esc="opening_note"/>
            </t>

            <t t-if="closing_note">
                <br/>
                <div>------------------------</div>
                <br/>
                <div><strong>Nota de cierre</strong></div>
                <div t-esc="closing_note"/>
            </t>

            <br/>
            <div class="pos-receipt-order-data">
                <div t-esc="date_time"/>
            </div>
            <br/>
            <br/>
            <br/>
        </div>
    </t>

    <t t-name="servincom_pos_closing_receipt.ClosePosPopupBreakdown"
       t-inherit="point_of_sale.ClosePosPopup" t-inherit-mode="extension" owl="1">
        <xpath expr="//tbody[contains(@class, 'cash-overview')]/tr[@t-if='defaultCashDetails.payment_amount']" position="after">
            <t t-if="defaultCashDetails.servincom_breakdown">
                <tr t-if="defaultCashDetails.servincom_breakdown.sales_amount">
                    <td>
                        <div class="flex servincom-closing-breakdown-label">
                            <div class="cash-sign">+</div>
                            Ventas TPV
                        </div>
                    </td>
                    <td class="servincom-closing-breakdown-amount"
                        t-esc="env.pos.format_currency(defaultCashDetails.servincom_breakdown.sales_amount)"/>
                </tr>
                <tr t-foreach="defaultCashDetails.servincom_breakdown.refunds || []"
                    t-as="refund" t-key="refund_index">
                    <td>
                        <div class="flex servincom-closing-breakdown-label">
                            <div class="cash-sign">-</div>
                            Reembolso <t t-esc="refund.name"/>
                        </div>
                    </td>
                    <td class="servincom-closing-breakdown-amount"
                        t-esc="env.pos.format_currency(Math.abs(refund.amount))"/>
                </tr>
            </t>
        </xpath>

        <xpath expr="//tbody[@t-if='otherPaymentMethods.length &gt; 0']/tr/td[@t-esc='pm.name']" position="replace">
            <td class="servincom-closing-method-cell">
                <div t-esc="pm.name"/>
                <t t-if="pm.servincom_breakdown">
                    <div t-if="pm.servincom_breakdown.sales_amount"
                         class="servincom-closing-breakdown-label">
                        Ventas TPV
                    </div>
                    <t t-foreach="pm.servincom_breakdown.credit_payments || []"
                       t-as="credit" t-key="credit_index">
                        <div class="servincom-closing-breakdown-label">
                            Cobro deuda clientes <t t-esc="credit.name"/>
                        </div>
                    </t>
                    <t t-foreach="pm.servincom_breakdown.refunds || []"
                       t-as="refund" t-key="refund_index">
                        <div class="servincom-closing-breakdown-label">
                            Reembolso <t t-esc="refund.name"/>
                        </div>
                    </t>
                </t>
            </td>
        </xpath>

        <xpath expr="//tbody[@t-if='otherPaymentMethods.length &gt; 0']/tr/td[@t-esc='env.pos.format_currency(pm.amount)']" position="replace">
            <td class="servincom-closing-method-cell">
                <div t-esc="env.pos.format_currency(pm.amount)"/>
                <t t-if="pm.servincom_breakdown">
                    <div t-if="pm.servincom_breakdown.sales_amount"
                         class="servincom-closing-breakdown-amount"
                         t-esc="env.pos.format_currency(pm.servincom_breakdown.sales_amount)"/>
                    <t t-foreach="pm.servincom_breakdown.credit_payments || []"
                       t-as="credit" t-key="credit_index">
                        <div class="servincom-closing-breakdown-amount"
                             t-esc="env.pos.format_currency(credit.amount)"/>
                    </t>
                    <t t-foreach="pm.servincom_breakdown.refunds || []"
                       t-as="refund" t-key="refund_index">
                        <div class="servincom-closing-breakdown-amount"
                             t-esc="env.pos.format_currency(refund.amount)"/>
                    </t>
                </t>
            </td>
        </xpath>
    </t>

</templates>
