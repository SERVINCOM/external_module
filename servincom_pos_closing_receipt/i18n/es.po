#. module: servincom_pos_closing_receipt
msgid "Improved POS sales and closing receipts"
msgstr "Tickets mejorados de venta y cierre de sesión del TPV"

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_pos_config__servincom_hide_receipt_taxes
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_res_config_settings__pos_servincom_hide_receipt_taxes
msgid "Hide tax details on POS receipts"
msgstr "Ocultar el detalle de impuestos en los tickets del TPV"

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,help:servincom_pos_closing_receipt.field_pos_config__servincom_hide_receipt_taxes
msgid "Hide the tax breakdown and total taxes on customer receipts. Enable it only for tax regimes that require receipts without tax details."
msgstr "Oculta el desglose y el total de impuestos en los tickets del cliente. Actívelo únicamente en regímenes fiscales que requieran tickets sin detalle de impuestos."

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_pos_config__servincom_anonymize_receipt_operator
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_res_config_settings__pos_servincom_anonymize_receipt_operator
msgid "Use receipt operator identifier"
msgstr "Usar identificador de operario en los tickets"

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,help:servincom_pos_closing_receipt.field_pos_config__servincom_anonymize_receipt_operator
msgid "Replace the cashier's full name with the configured operator identifier on customer receipts."
msgstr "Sustituye el nombre completo del cajero por el identificador de operario configurado en los tickets del cliente."

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_hr_employee__servincom_pos_receipt_operator_label
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_res_users__servincom_pos_receipt_operator_label
msgid "Receipt operator identifier"
msgstr "Identificador de operario para el ticket"

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,help:servincom_pos_closing_receipt.field_hr_employee__servincom_pos_receipt_operator_label
msgid "Public identifier printed instead of the employee's full name on customer receipts, for example: Operator 01."
msgstr "Identificador público que se imprime en los tickets del cliente en lugar del nombre completo del empleado, por ejemplo: Operario 01."

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,help:servincom_pos_closing_receipt.field_res_users__servincom_pos_receipt_operator_label
msgid "Public identifier printed instead of the user's full name on customer receipts, for example: Operator 01."
msgstr "Identificador público que se imprime en los tickets del cliente en lugar del nombre completo del usuario, por ejemplo: Operario 01."

#. module: servincom_pos_closing_receipt
#: model_terms:ir.ui.view,arch_db:servincom_pos_closing_receipt.res_config_settings_view_form_pos_receipt_options
msgid "Retailer receipt without tax details"
msgstr "Ticket de comerciante minorista"

#. module: servincom_pos_closing_receipt
#: model_terms:ir.ui.view,arch_db:servincom_pos_closing_receipt.res_config_settings_view_form_pos_receipt_options
msgid "Hide the tax breakdown and total taxes on the customer receipt."
msgstr "Oculta el desglose y el total de impuestos en el ticket del cliente."

#. module: servincom_pos_closing_receipt
#: model:ir.model.fields,field_description:servincom_pos_closing_receipt.field_pos_config__servincom_customize_receipt_operator
