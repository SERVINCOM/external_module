<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_pos_customer_credit" model="ir.ui.view">
        <field name="name">res.partner.form.pos.customer.credit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_view_pos_credit_lines"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-credit-card"
                    attrs="{'invisible': [('pos_credit_ticket_count', '=', 0)]}"
                >
                    <field
                        name="pos_credit_ticket_count"
                        widget="statinfo"
                        string="Crédito TPV"
                    />
                </button>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="pos_credit" string="TPV / Crédito">
                    <group>
                        <group string="Crédito TPV">
                            <field name="pos_credit_customer"/>
                            <field name="pos_credit_total_due" readonly="1"/>
                            <field name="pos_credit_ticket_count" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
