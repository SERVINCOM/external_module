<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_pos_customer_credit_user" model="res.groups">
        <field name="name">Usuario crédito clientes TPV</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4, ref('point_of_sale.group_pos_user'))]"/>
    </record>

    <record id="group_pos_customer_credit_manager" model="res.groups">
        <field name="name">Responsable crédito clientes TPV</field>
        <field name="category_id" ref="base.module_category_sales_point_of_sale"/>
        <field name="implied_ids" eval="[(4, ref('group_pos_customer_credit_user')), (4, ref('point_of_sale.group_pos_manager'))]"/>
    </record>
</odoo>
