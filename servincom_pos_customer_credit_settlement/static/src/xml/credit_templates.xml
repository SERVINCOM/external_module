<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="servincom_pos_customer_credit_settlement.CreditButton" owl="1">
        <button class="control-button o_pos_credit_settlement_button" t-on-click="onClick">
            <i class="fa fa-credit-card" role="img" aria-label="Cobrar deuda" title="Cobrar deuda"/>
            <span>Cobrar deuda</span>
        </button>
    </t>

    <t t-name="servincom_pos_customer_credit_settlement.PosCreditPaymentPopup" owl="1">
        <div class="popup popup-credit-payment o_pos_credit_popup">
            <div class="modal-header o_pos_credit_popup_header">
                <div>
                    <h4 class="modal-title"><t t-esc="props.title"/></h4>
                    <div class="o_pos_credit_popup_subtitle">
                        Seleccione cliente, tickets pendientes y método real de cobro.
                    </div>
                </div>
                <div class="o_pos_credit_popup_total">
                    <span>Total seleccionado</span>
                    <strong><t t-esc="formatCurrency(selectedTotal)"/></strong>
                </div>
            </div>

            <div t-if="state.error" class="o_pos_credit_alert error">
                <t t-esc="state.error"/>
            </div>
            <div t-if="state.success" class="o_pos_credit_alert success">
                <t t-esc="state.success"/>
            </div>

            <main class="modal-body o_pos_credit_popup_body">
                <section class="o_pos_credit_customers_panel">
                    <div class="o_pos_credit_panel_title">Clientes de crédito</div>
                    <div class="o_pos_credit_search">
                        <i class="fa fa-search"/>
                        <input
                            class="o_pos_credit_search_input"
                            type="text"
                            placeholder="Buscar cliente"
                            t-att-value="state.query"
                            t-on-input="onQueryInput"
                            t-on-keyup="onQueryInput"
                            t-on-change="onQueryInput"
                        />
                    </div>
                    <div class="client-list o_pos_credit_customer_list">
                        <t t-if="state.loading">
                            <div class="o_pos_credit_empty">Cargando...</div>
                        </t>
                        <t t-if="!state.loading &amp;&amp; !state.customers.length">
                            <div class="o_pos_credit_empty">No hay clientes para esta búsqueda.</div>
                        </t>
                        <t t-foreach="state.customers" t-as="customer" t-key="customer.id">
                            <button
                                type="button"
                                t-att-data-partner-id="customer.id"
                                t-att-class="state.selectedPartner &amp;&amp; state.selectedPartner.id === customer.id ? 'o_pos_credit_customer selected' : 'o_pos_credit_customer'"
                                t-on-click="onCustomerClick"
                            >
                                <span class="o_pos_credit_customer_name">
                                    <t t-esc="customer.name"/>
                                </span>
                                <span class="o_pos_credit_customer_meta">
                                    <t t-esc="customer.vat || customer.ref || customer.phone || 'Sin referencia'"/>
                                </span>
                                <span class="o_pos_credit_customer_due">
                                    <t t-esc="customer.ticket_count"/> tickets ·
                                    <t t-esc="formatCurrency(customer.total_due)"/>
                                </span>
                            </button>
                        </t>
                    </div>
                </section>

                <section class="o_pos_credit_lines_panel">
                    <t t-if="state.selectedPartner">
                        <div class="o_pos_credit_selected_customer">
                            <div>
                                <span>Cliente seleccionado</span>
                                <strong><t t-esc="state.selectedPartner.name"/></strong>
                            </div>
                            <div>
                                <span>Pendiente actual</span>
                                <strong><t t-esc="formatCurrency(state.selectedPartner.total_due)"/></strong>
                            </div>
                        </div>

                        <div class="o_pos_credit_table_wrapper">
                            <table class="table table-sm o_pos_credit_table">
                                <thead>
                                    <tr>
                                        <th/>
                                        <th>Fecha</th>
                                        <th>Ticket</th>
                                        <th class="text-end">Original</th>
                                        <th class="text-end">Cobrado</th>
                                        <th class="text-end">Pendiente</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr t-if="!state.lines.length">
                                        <td colspan="6" class="o_pos_credit_empty_table">Sin tickets pendientes</td>
                                    </tr>
                                    <t t-foreach="state.lines" t-as="line" t-key="line.id">
                                        <tr t-att-class="state.selectedLineIds[line.id] ? 'selected' : ''">
                                            <td>
                                                <input
                                                    type="checkbox"
                                                    t-att-data-line-id="line.id"
                                                    t-att-checked="state.selectedLineIds[line.id] ? true : undefined"
                                                    t-on-change="onLineToggle"
                                                />
                                            </td>
                                            <td><t t-esc="line.date_order"/></td>
                                            <td><t t-esc="line.pos_order_name"/></td>
                                            <td class="text-end"><t t-esc="formatCurrency(line.amount_total)"/></td>
                                            <td class="text-end"><t t-esc="formatCurrency(line.amount_paid)"/></td>
                                            <td class="text-end o_pos_credit_residual"><t t-esc="formatCurrency(line.amount_residual)"/></td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div class="o_pos_credit_payment_box">
                            <label>
                                <span>Importe a cobrar</span>
                                <input
                                    type="number"
                                    step="0.01"
                                    min="0"
                                    class="form-control"
                                    t-att-value="state.amount"
                                    t-on-input="onAmountInput"
                                />
                            </label>
                            <label>
                                <span>Método de cobro</span>
                                <select
                                    class="form-control"
                                    t-att-value="state.payment_method_id"
                                    t-on-change="onPaymentMethodChange"
                                >
                                    <t t-foreach="paymentMethods" t-as="method" t-key="method.id">
                                        <option t-att-value="method.id">
                                            <t t-esc="method.name"/>
                                        </option>
                                    </t>
                                </select>
                            </label>
                        </div>
                    </t>
                    <t t-else="">
                        <div class="o_pos_credit_no_customer">
                            <i class="fa fa-user-o"/>
                            <div>
                                <strong>Seleccione un cliente de crédito</strong>
                                <span>Use el buscador para ver sus tickets pendientes.</span>
                            </div>
                        </div>
                    </t>
                </section>
            </main>

            <footer class="footer modal-footer">
                <button class="button cancel" t-on-click="closePopup">
                    <t t-esc="props.cancelText"/>
                </button>
                <button class="button confirm highlight" t-on-click="confirmPayment">
                    <t t-esc="props.confirmText"/>
                </button>
            </footer>
        </div>
    </t>
</templates>
