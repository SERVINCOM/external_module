<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t
        t-name="servincom_pos_customer_credit_settlement.ClosePosPopupSaleDetailsButton"
        t-inherit="ClosePosPopup"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//SaleDetailsButton" position="attributes">
            <attribute name="ordersDetails">ordersDetails</attribute>
            <attribute name="defaultCashDetails">defaultCashDetails</attribute>
            <attribute name="otherPaymentMethods">otherPaymentMethods</attribute>
            <attribute name="openingNotes">openingNotes</attribute>
            <attribute name="cashControl">cashControl</attribute>
            <attribute name="state">state</attribute>
        </xpath>
    </t>

    <t
        t-name="servincom_pos_customer_credit_settlement.SaleDetailsReportClosing"
        t-inherit="SaleDetailsReport"
        t-inherit-mode="extension"
        owl="1"
    >
        <xpath expr="//div[hasclass('pos-receipt-order-data')]" position="before">
            <t t-if="closingData">
                <br/>
                <div>------------------------</div>
                <br/>

                <div>
                    Cierre de caja
                </div>
                <div>
                    Pedidos:
                    <span class="pos-receipt-right-align">
                        <t t-esc="closingData.orders.quantity"/>
                    </span>
                </div>
                <div>
                    Total pedidos:
                    <span
                        t-esc="pos.format_currency_no_symbol(closingData.orders.amount)"
                        class="pos-receipt-right-align"
                    />
                </div>

                <t t-if="closingData.cash">
                    <br/>
                    <div>
                        <t t-esc="closingData.cash.name"/>
                        <span
                            t-esc="pos.format_currency_no_symbol(closingData.cash.expected)"
                            class="pos-receipt-right-align"
                        />
                    </div>
                    <div class="pos-receipt-left-padding">
                        Apertura
                        <span
                            t-esc="pos.format_currency_no_symbol(closingData.cash.opening)"
                            class="pos-receipt-right-align"
                        />
                    </div>
                    <t t-foreach="closingData.cash.moves" t-as="move" t-key="move_index">
                        <div class="pos-receipt-left-padding">
                            <t t-esc="move.amount &lt; 0 ? '-' : '+'"/>
                            <t t-esc="move.name"/>
                            <span
                                t-esc="pos.format_currency_no_symbol(Math.abs(move.amount))"
                                class="pos-receipt-right-align"
                            />
                        </div>
                    </t>
                    <div t-if="closingData.cash.paymentAmount" class="pos-receipt-left-padding">
                        <t t-esc="closingData.cash.paymentAmount &lt; 0 ? '-' : '+'"/>
                        Pagos en <t t-esc="closingData.cash.name"/>
                        <span
                            t-esc="pos.format_currency_no_symbol(Math.abs(closingData.cash.paymentAmount))"
                            class="pos-receipt-right-align"
                        />
                    </div>
                    <div class="pos-receipt-left-padding">
                        Contado
                        <span
                            t-esc="pos.format_currency_no_symbol(closingData.cash.counted)"
                            class="pos-receipt-right-align"
                        />
                    </div>
                    <div class="pos-receipt-left-padding">
                        Diferencia
                        <span
                            t-esc="pos.format_currency_no_symbol(closingData.cash.difference)"
                            class="pos-receipt-right-align"
                        />
                    </div>
                </t>

                <t t-if="closingData.paymentMethods.length">
                    <br/>
                    <t
                        t-foreach="closingData.paymentMethods"
                        t-as="paymentMethod"
                        t-key="paymentMethod.id"
                    >
                        <div>
                            <t t-esc="paymentMethod.name"/>
                            <span
                                t-esc="pos.format_currency_no_symbol(paymentMethod.expected)"
                                class="pos-receipt-right-align"
                            />
                        </div>
                        <t t-if="paymentMethod.showDifference">
                            <div class="pos-receipt-left-padding">
                                Contado
                                <span
                                    t-esc="pos.format_currency_no_symbol(paymentMethod.counted)"
                                    class="pos-receipt-right-align"
                                />
                            </div>
                            <div class="pos-receipt-left-padding">
                                Diferencia
                                <span
                                    t-esc="pos.format_currency_no_symbol(paymentMethod.difference)"
                                    class="pos-receipt-right-align"
                                />
                            </div>
                        </t>
                    </t>
                </t>

                <t t-if="closingData.openingNotes">
                    <br/>
                    <div>Notas de apertura:</div>
                    <div class="pos-receipt-left-padding">
                        <t t-esc="closingData.openingNotes"/>
                    </div>
                </t>

                <t t-if="closingData.notes">
                    <br/>
                    <div>Notas de cierre:</div>
                    <div class="pos-receipt-left-padding">
                        <t t-esc="closingData.notes"/>
                    </div>
                </t>
            </t>
        </xpath>
    </t>

</templates>
