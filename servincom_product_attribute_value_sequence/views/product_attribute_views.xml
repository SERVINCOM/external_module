<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_template_attribute_value_list_sequence" model="ir.ui.view">
        <field name="name">product.template.attribute.value.list.sequence</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="attributes">
                <attribute name="default_order">sequence, product_attribute_value_id, id</attribute>
            </xpath>
            <xpath expr="//list/field[1]" position="before">
                <field name="sequence" widget="handle"/>
            </xpath>
        </field>
    </record>
    <record id="product_template_attribute_value_form_sequence" model="ir.ui.view">
        <field name="name">product.template.attribute.value.form.sequence</field>
        <field name="model">product.template.attribute.value</field>
        <field name="inherit_id" ref="product.product_template_attribute_value_view_form"/>
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="sequence"/>
            </field>
        </field>
    </record>
</odoo>
