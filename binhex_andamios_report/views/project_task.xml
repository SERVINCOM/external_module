<odoo>
  <data>
        <record id="binhex_project_task_report" model="ir.ui.view">
            <field name="name">binhex.project.task.report</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="binhex_andamios.binhex_project_task_scaffold"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='assembly_date']" position="attributes">
                    <attribute name="invisible">task_type != 'assembly' and task_type != 'both'</attribute>
                </xpath>
                <xpath expr="//field[@name='cubic_meters']" position="attributes">
                    <attribute name="invisible">task_type != 'assembly' and task_type != 'both'</attribute>
                </xpath>
                <xpath expr="//field[@name='disassembly_date']" position="attributes">
                    <attribute name="invisible">task_type != 'disassembly' and task_type != 'both'</attribute>
                </xpath>
                <xpath expr="//field[@name='cubic_meters']" position="attributes">
                    <attribute name="invisible">task_type != 'disassembly' and task_type != 'both'</attribute>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
