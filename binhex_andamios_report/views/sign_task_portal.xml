<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="binhex_sign_task_portal" inherit_id="project.portal_my_task">
        <xpath expr="//div[@t-if='task.partner_id']" position="after">
            <div class="col-lg-3 col-md-12 mt-4" t-if='task.partner_id'>
                <a role="button" class="btn btn-primary btn-block mb8" data-toggle="modal" data-target="#modalsign" href="#">
                    <i class="fa fa-check"/> Firmar <t t-if="task.signature">otra vez</t>
                </a>
            </div>
            <div role="dialog" class="modal fade" id="modalsign">
                <div class="modal-dialog">
                    <form id="accept" method="POST" t-att-data-task-id="task.id" t-att-data-token="task.access_token" class="js_accept_json modal-content js_website_submit_form">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <header class="modal-header">
                            <h4 class="modal-title">Sign task</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">&amp;times;</button>
                        </header>
                        <main class="modal-body" id="sign-dialog">
                            <t t-call="portal.signature_form">
                                <t t-set="call_url" t-value="task.get_portal_url(suffix='/accept')"/>
                                <t t-set="default_name" t-value="task.partner_id.name"/>
                            </t>
                        </main>
                    </form>
                </div>
            </div>
        </xpath>
    </template>
</odoo>