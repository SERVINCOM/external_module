<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="parte_unico" model="report.paperformat">
        <field name="name">Parte unico</field>
        <field name="default"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">2</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">15</field>
        <field name="dpi">95</field>
    </record>

    <record id="action_report_parte_unico" model="ir.actions.report">
        <field name="name">Parte Unico</field>
        <field name="model">project.task</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">binhex_andamios_report.report_parte_unico</field>
        <field name="print_report_name">object.name</field>
        <field name="paperformat_id" ref="binhex_andamios_report.parte_unico" />
        <field name="binding_model_id" ref="project.model_project_task"/>
    </record>
</odoo>
