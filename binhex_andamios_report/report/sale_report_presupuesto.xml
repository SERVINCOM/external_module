<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ateca_custom_paper" model="report.paperformat">
        <field name="name">Ateca Generic Paper</field>
        <field name="default"/>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">47</field>
        <field name="margin_bottom">40</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">42</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_saleorder_generic" model="ir.actions.report">
        <field name="name">Presupuesto Generico</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">binhex_andamios_report.report_saleorder_generic</field>
        <field name="report_file">binhex_andamios_report.report_saleorder_generic</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="paperformat_id" ref="ateca_custom_paper"/>
    </record>

    <record id="action_report_saleorder_specific" model="ir.actions.report">
        <field name="name">Presupuesto Especifico</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">binhex_andamios_report.report_saleorder_specific</field>
        <field name="report_file">binhex_andamios_report.report_saleorder_specific</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="paperformat_id" ref="ateca_custom_paper"/>
    </record>
</odoo>
