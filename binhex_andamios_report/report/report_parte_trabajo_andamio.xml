                                <div t-if="doc.signature">
                                    <img
                                        t-attf-src="data:image/*;base64,{{doc.signature}}"
                                        t-att-alt="signature"
                                        />
                                </div>
                            </td>
                            <td class="boldBorder boldText " colspan="5" >OBSERVACIONES: <br/>  <br/> <br/> <br/> <br/> <br/></td>
