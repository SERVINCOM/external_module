    <template id="report_parte_trabajo_andamio">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="binhex_andamios_report.report_parte_trabajo_andamio_document" t-lang="doc.partner_id.lang"/>
