<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_parte_trabajo_andamio_document">
        <t t-set="doc" t-value="doc.with_context({'lang':doc.partner_id.lang})"/>
        <t t-call="web.basic_layout">
            <div class="page">
                <style>
                    table {
                        border-collapse: collapse;
                    }

                    table, th, td {
                        border: 2px solid black;
                    }
                    .boldBorder{
                        border: 2px solid black;
                    }
                    .boldBorder2{
                        border: 2px solid black;
                    }
                    .tableAll {
                        width: 900px;
                    }
                    .center{
                        text-align: center;
                    }
                    .right{
                        text-align: right;
                    }
                    .left{
                        text-align: left;
                    }
                    .boldText{
                        font-weight: bold;
                    }
                    .yellow{
                        background-color: rgb(255, 255, 130);
                    }
                </style>
                <div class="reporte">
                    <table class="tableAll boldBorder">
                        <tr>
                            <td class="boldBorder boldText" rowspan="4"> <img src="logo.png"/> </td>
                            <td class="boldBorder boldText center" colspan="6">CONTROL PARTE DIARIO DE TRABAJO</td>
                        </tr>
                        <tr>
                            <td class="boldBorder boldText" colspan="1">Parte Nº:</td>
                            <td class="boldBorder boldText" colspan="2">
                                <div t-if="doc.id">
                                    <p t-field="doc.id"/>
                                </div>
                            </td>
                            <td class="boldBorder boldText" colspan="1">Cliente:</td>
                            <td class="boldBorder boldText" colspan="2">
                                <div t-if="doc.partner_id">
                                    <p t-field="doc.partner_id"/>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="boldBorder boldText" colspan="1">Fecha:</td>
                            <td class="boldBorder boldText" colspan="2">
                                <div t-if="doc.date_order">
                                    <p>  <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d-%m-%Y')"/></p>
                                </div>
                            </td>
                            <td class="boldBorder boldText" colspan="1">Nº Oferta:</td>
                            <td class="boldBorder boldText" colspan="2">
                                <div t-if="doc">
                                    <p t-field="doc.name"/>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td class="boldBorder boldText" colspan="1">Tipo Trabajo:</td>
