<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">
    <t
        t-name="pos_product_image_lazy_load.ProductCard"
        t-inherit="point_of_sale.ProductCard"
        t-inherit-mode="extension"
    >
        <xpath expr="//div[hasclass('product-img')]" position="attributes">
            <attribute name="t-ref">deferredImageContainer</attribute>
        </xpath>
        <xpath expr="//div[hasclass('product-img')]/img" position="attributes">
            <attribute name="t-if">deferredImageState.src</attribute>
            <attribute name="t-att-src">deferredImageState.src</attribute>
            <attribute name="t-on-load">onDeferredImageSettled</attribute>
            <attribute name="t-on-error">onDeferredImageSettled</attribute>
            <attribute name="loading">lazy</attribute>
            <attribute name="decoding">async</attribute>
        </xpath>
    </t>
</templates>
