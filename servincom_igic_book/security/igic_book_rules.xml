<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_igic_line_company" model="ir.rule">
        <field name="name">IGIC line: company isolation</field>
        <field name="model_id" ref="l10n_es_vat_book.model_l10n_es_vat_book_line"/>
        <field name="domain_force">["|", ("vat_book_id.servincom_is_igic", "=", False), ("vat_book_id.company_id", "in", company_ids)]</field>
    </record>
