<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.picking_validation</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr='//notebook' position='inside'>
                <page name="picking_validation" string="Stock picking">
                    <group name="container_row_2">
                        <group name="email_validation" string="Email Confirmation picking">
                            <field name="stock_move_email_validation"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
