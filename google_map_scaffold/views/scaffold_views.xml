<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record model="ir.ui.view" id="geo_scaffold_view_form">
            <field name="name">geo scaffold form</field>
            <field name="model">scaffold.scaffold</field>
            <field name="inherit_id" ref="binhex_andamios.andamios_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <button name="action_open_google_map" string="Open Google Map" type="object" class="oe_highlight"/>
                </xpath>
                <xpath expr="//notebook" position="inside">
                        <page
                        string="Google Map"
                        name="google_map"
                    >
                        <group>
                            <group>
                                <separator string="Address" colspan="2"/>
                                <div class="o_address_format">
                                    <field name="street" placeholder="Street..." class="o_address_street"/>
                                    <field name="city" placeholder="City" class="o_address_city"/>
                                    <field name="state_id" class="o_address_state" placeholder="State" options="{'no_open': True, 'no_quick_create': True}" context="{'default_country_id': country_id}"/>
                                    <field name="zip" placeholder="ZIP" class="o_address_zip"/>
                                    <field name="country_id" placeholder="Country" class="o_address_country" options='{"no_open": True, "no_create": True}'/>
                                </div>
                            </group>
                            <group>
                                <separator string="Geolocation" colspan="2"/>
                                    <field name="scaffold_latitude"/>
                                    <field name="scaffold_longitude"/>
                                    <button
                                    string="Geolocate"
                                    name="geo_localize"
                                    colspan="2"
                                    icon="fa-check"
                                    type="object"
                                    class="btn btn-primary"

                                    />
                                <div>
                                </div>
                            </group>
                        </group>
                    </page>
                </xpath>
            </field>
        </record>


        <record id="view_scaffold_scaffold_google_map" model="ir.ui.view">
        <field name="name">view.scaffold.scaffold.google_map</field>
        <field name="model">scaffold.scaffold</field>
        <field name="arch" type="xml">
            <google_map
                sidebar_title="name"
                string="Google Map"
                sidebar_subtitle="alias"
                lat="scaffold_latitude"
                lng="scaffold_longitude"
                js_class="google_map_scaffold"
                description="description"
            >
                <field name="id" />
                <field name="name"/>
                <field name="alias"/>
                <field name="scaffold_latitude" />
                <field name="scaffold_longitude" />
                <field name="description"/>
            </google_map>
        </field>
    </record>



        <record id="binhex_andamios.andamios_action_window" model="ir.actions.act_window">
            <field name="view_mode">list,kanban,form,google_map</field>
        </record>

    </data>
</odoo>
