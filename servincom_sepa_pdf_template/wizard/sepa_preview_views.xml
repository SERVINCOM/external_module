<odoo>
    <record id="sepa_preview_form" model="ir.ui.view">
        <field name="name">servincom.sepa.pdf.preview.form</field>
        <field name="model">servincom.sepa.pdf.preview</field>
        <field name="arch" type="xml">
            <form string="Preview SEPA mandate">
                <group>
                    <field name="company_id" readonly="1"/>
                    <field name="mandate_id" domain="[('company_id', '=', company_id), ('format', '=', 'sepa')]" options="{'no_create': True}"/>
                    <field name="scheme"/>
                    <field name="template_name"/>
                    <field name="filename" invisible="1"/>
                    <field name="pdf_file" filename="filename" invisible="not pdf_file"/>
                </group>
                <footer>
                    <button name="action_preview" type="object" string="Generate preview" class="btn-primary"/>
                    <button string="Close" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
